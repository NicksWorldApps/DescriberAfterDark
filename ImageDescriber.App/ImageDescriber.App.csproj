<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is used only for its image decoder, which can read WebP. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ImageDescriber.App</RootNamespace>
    <AssemblyName>DescriberAfterDark</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.1</Version>
    <Product>Describer After Dark</Product>

    <!-- Settings used by: dotnet publish -c Release -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Pack the .NET and WPF support files inside the exe, so only DescriberAfterDark.exe, prism.dll and the licenses sit in the folder. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageDescriber.Core\ImageDescriber.Core.csproj" />
  </ItemGroup>

  <!-- Turning on WPF removes System.IO from the automatic imports, so add it back for File, Path, Directory and MemoryStream. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Bundled Prism 0.18.2 (64-bit) and its licenses; copied next to the program. -->
  <ItemGroup>
    <None Include="..\native\prism.dll" Condition="Exists('..\native\prism.dll')">
      <Link>prism.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="..\native\licenses\**\*" Condition="Exists('..\native\licenses')">
      <Link>third-party-licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="..\native\README.txt" Condition="Exists('..\native\README.txt')">
      <Link>third-party-licenses\PRISM-README.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
